#!/usr/bin/env bash
# ============================================================
# Baseline — one-command project guard (Proactive Auditing Rule)
#   ./selfcheck         fast, offline: static + units + invariants
#   ./selfcheck --full  also runs the headless-Chrome render crosscheck
# Exits non-zero if ANY check fails. Fails closed: a missing tool
# or unreadable file blocks rather than silently passing.
# ============================================================
set -uo pipefail
cd "$(dirname "$0")" || { echo "❌ cannot cd to project dir"; exit 2; }

command -v node >/dev/null 2>&1 || { echo "❌ node not found (failing closed)"; exit 2; }

fail=0
step() {
  local label="$1"; shift
  echo ""
  echo "▶ $label"
  if "$@"; then :; else fail=1; echo "  ↳ FAILED: $label"; fi
}

echo "=================================================="
echo " Baseline selfcheck"
echo "=================================================="

# fast / offline path — safe for a pre-commit hook (no network, no browser)
step "static + data + regression guards"  node verify.js
step "adversarial unit tests"             node test/functions.test.js
# property/oracle over RANDOM scenarios, with an oracle that does NOT import the page's
# constants. Fixture tests pin the output shape and cement a wrong claim as the baseline;
# this asserts invariants no single example can cement (Generated-Claims Rule).
step "generated-claims property harness"  node test/claims_harness.js
step "universal invariants"               node test/invariants.js

# heavy / live path — opt-in
if [ "${1:-}" = "--full" ]; then
  step "rendered crosscheck (headless Chrome, 4 combos)" node crosscheck.js
  # width/alignment/structure. crosscheck measures the CONTAINER and passed 52/52 on a
  # footer whose text used 47% of its box — this measures the text and locks the
  # desktop-vs-mobile structure to a committed baseline.
  step "layout: width use + structure lock (4 viewports)" node layout.js
  # the visual pass, automated: contrast/clipping/overlap/blank scans that need no
  # reference, plus a pixel diff of every section against committed approved images.
  step "visual: defect scans + pixel diff vs approved refs" node visual.js
  # the interaction tests: these drive the real page (spaced repetition, path filtering,
  # tally gating, Labs) in a browser. They used to live in a temp dir, which meant nobody
  # but me could re-run them — the opposite of the point.
  step "runtime: return loop + spaced repetition"  node test/return-loop.runtime.js
  step "runtime: paths, playground, labs, tally"   node test/features.runtime.js
  step "runtime: layer 2 (deep sections open on top)" node test/layer2.runtime.js
  step "runtime: mobile fold (long optional sections)" node test/mobilefold.runtime.js
elif [ "${1:-}" = "--live" ]; then
  step "source⇄live parity (fetches the deployed site)" node parity.js
else
  echo ""
  echo "  (skipping browser/live passes — './selfcheck --full' renders, './selfcheck --live' checks the deploy)"
fi

echo ""
echo "=================================================="
if [ "$fail" -eq 0 ]; then
  echo " ✅ selfcheck PASS"
else
  echo " ❌ selfcheck FAIL — do not ship"
fi
echo "=================================================="
exit "$fail"
